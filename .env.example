# Permanent storage (Neon / Vercel Postgres)
# Get this from neon.tech or Vercel → Storage → Create Database → Neon
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Public site URL (magic-link redirects, sitemap, canonical)
NEXT_PUBLIC_SITE_URL=https://www.toursiwant.com

# Google Analytics 4 — Measurement ID from analytics.google.com (G-XXXXXXXX)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Google Search Console — HTML tag verification content value
# (Search Console → Settings → Ownership verification → HTML tag)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Magic-link email via Resend (https://resend.com)
# 1) Verify a domain in Resend (prefer mail.toursiwant.com or toursiwant.com)
# 2) Add the DNS records Resend shows (SPF / DKIM / DMARC)
# 3) Set FROM to an address on that verified domain
RESEND_API_KEY=
RESEND_FROM_EMAIL=ToursIWant <login@toursiwant.com>
