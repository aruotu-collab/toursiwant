# Permanent storage (Neon / Vercel Postgres)
# Get this from neon.tech or Vercel → Storage → Create Database → Neon
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Public site URL (magic-link redirects, sitemap, canonical)
NEXT_PUBLIC_SITE_URL=https://www.toursiwant.com

# Google Analytics 4 — Measurement ID from analytics.google.com (G-XXXXXXXX)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Google Search Console — HTML tag verification content value
# (Search Console → Settings → Ownership verification → HTML tag)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Google Places — USA-wide hotel search + nearby (bus, museum, pizza, Chinese…)
# Enable Places API + Places API (legacy nearby/autocomplete) in Google Cloud
# Restrict the key to your server / Vercel IPs when possible
GOOGLE_PLACES_API_KEY=

# Platform owners (always admin). Comma-separated. Defaults to aruotu@gmail.com
PLATFORM_ADMIN_EMAILS=aruotu@gmail.com
NEXT_PUBLIC_PLATFORM_ADMIN_EMAILS=aruotu@gmail.com

# Magic-link email via Resend (https://resend.com)
# 1) Verify a domain in Resend (prefer mail.toursiwant.com or toursiwant.com)
# 2) Add the DNS records Resend shows (SPF / DKIM / DMARC)
# 3) Set FROM to an address on that verified domain
RESEND_API_KEY=
RESEND_FROM_EMAIL=ToursIWant <login@toursiwant.com>

# Affiliate / Viator Partner API (Basic Access)
# Sandbox key first (VIATOR_API_ENV=sandbox), then production key when live.
# Never expose API keys to the browser — server-only.
VIATOR_API_KEY=
VIATOR_API_ENV=sandbox
# Optional: partner id for non-API deep links
VIATOR_PARTNER_ID=

TIQETS_PARTNER_ID=
KLOOK_AID=
EXPEDIA_CAMREF=
AIRALO_AFFILIATE_ID=
DISCOVERCARS_AFFILIATE_ID=

