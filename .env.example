# Permanent storage (Neon / Vercel Postgres)
# Get this from neon.tech or Vercel → Storage → Create Database → Neon
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Public site URL (magic-link redirects)
NEXT_PUBLIC_SITE_URL=https://www.toursiwant.com

# Optional: real magic-link emails via Resend (https://resend.com)
# Without these, the app still works — magic URLs are shown on-screen after signup.
RESEND_API_KEY=
RESEND_FROM_EMAIL=ToursIWant <onboarding@resend.dev>
